#!/usr/bin/env bash
# dev: start your interactive job (or reconnect to it) and open a shell in the
# current folder. Custom command from the RCP tutorial, run it on the jumphost.
#
# Usage: dev [JOB_NAME]      (default: DEV_JOB in the project's rcp/project.env, else dev)
#
# Inside a project with its own rcp/ folder, that project's settings are used.
# Anywhere else, the tutorial's defaults are used, starting in the current folder.
set -euo pipefail
tutorial=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

dir=$PWD
while [[ "$dir" != / && ! -f "$dir/rcp/project.env" ]]; do
    dir=$(dirname "$dir")
done
if [[ -f "$dir/rcp/project.env" ]]; then
    rcp=$dir/rcp
else
    rcp=$tutorial/rcp
    export RCP_WORK_DIR=$PWD
fi

export RCP_SHELL_DIR=$PWD
exec bash "$rcp/interactive.sh" "$@"
